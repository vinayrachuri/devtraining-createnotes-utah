<?xml version="1.0" encoding="UTF-8"?><record_update table="sp_widget">
    <sp_widget action="INSERT_OR_UPDATE">
        <category>custom</category>
        <client_script><![CDATA[api.controller = function($scope,$rootScope) {
  var c = this;

  $scope.$on('selectNote', function(event,id){
    c.data.noteID = id;

    c.server.get({
      action: "getNote",
      noteID: id
    }).then(function(r){
      c.data.title = r.note.title;
      c.data.note  = r.note.note;
    });
  });

  c.updateNote = function(field){
    c.server.update({
      action: "updateNote",
      noteID: c.data.noteID,
      noteTitle: c.data.title,
      noteBody: c.data.note
    });
  };
};
]]></client_script>
        <controller_as>c</controller_as>
